# .env.example — every environment variable Charlie reads, with a one-line description.
#
# Copy to `.env.local` (gitignored) and fill in real values:
#   cp .env.example .env.local
# Code loads `.env.local` via loadEnv() or `node --env-file=.env.local`; both strip an inline
# " # comment" from an unquoted value, so quote a value that must keep " #". This file holds
# PLACEHOLDERS ONLY; never paste a real key here.
#
# The REQUIRED blocks are the minimum to run the core pipeline. Everything else has an in-code
# default or belongs to one feature. Feature flags are dark (off) unless stated otherwise.
# Never put a secret in a NEXT_PUBLIC_* variable: those are shipped to the browser.

# ────────────────────────────────────────────────────────────────────────────
# REQUIRED — core pipeline (LLM, persistence, email, signed links)
# ────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                                  # all model calls (dossier, matching, composing, grounding)
VOYAGE_API_KEY=                                               # Voyage AI embeddings for the semantic pre-filter; unset = lexical ranking only
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co   # Supabase project URL
SUPABASE_URL=                                                 # fallback name for NEXT_PUBLIC_SUPABASE_URL (server scripts)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>                  # backend only; bypasses RLS
SUPABASE_SERVICE_KEY=                                         # fallback name for SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>                      # browser-safe, RLS-protected key (site waitlist action)
RESEND_API_KEY=re_...                                         # Resend send key; every send is skipped when unset
CHARLIE_FROM=charlie@mail.<your-domain>                       # From: address; its domain is also treated as "our own" by the inbound loop guard
CHARLIE_TOKEN_SECRET=<openssl rand -hex 32>                   # HMAC secret for unsubscribe, feedback and apply links
PUBLIC_BASE_URL=https://api.<your-domain>                     # public base URL of server/charlie-remote.ts, used in minted links
CHARLIE_SITE_URL=https://<your-domain>                        # marketing site base used in email links and images

# ────────────────────────────────────────────────────────────────────────────
# REQUIRED for inbound email
# ────────────────────────────────────────────────────────────────────────────
RESEND_READ_KEY=re_...                # full-access key to fetch inbound bodies and attachments; falls back to RESEND_API_KEY
RESEND_WEBHOOK_SECRET=whsec_...       # Svix secret for the delivery/bounce webhook (/webhooks/resend)
INBOUND_WEBHOOK_SECRET=whsec_...      # Svix secret for the /inbound webhook; falls back to RESEND_WEBHOOK_SECRET; unset = inbound rejected
CHARLIE_START_ADDR=start@mail.<your-domain>   # the onboarding address shown in email copy
JOIN_INBOUND=join@mail.<your-domain>          # inbound address of the hiring-campaign flow (JOIN_CAMPAIGN)
JOIN_ADDRESS=                                 # Reply-To for hiring-campaign nudges; defaults to the join@ address
QUESTION_APPLY_URL=                           # optional apply link included when Charlie acknowledges a question it cannot answer

# ────────────────────────────────────────────────────────────────────────────
# Operator identity and alerts
# ────────────────────────────────────────────────────────────────────────────
OWNER_EMAIL=you@example.com           # the operator's address: admin scripts' allowlists, owner-only debug routes, default alert recipient; unset = nobody is owner
ALERT_EMAIL=you@example.com           # where health-check, sweep and server alerts go (falls back to OWNER_EMAIL; no alert when both unset)
WATCHDOG_TO=you@example.com           # where watchdog and preflight alerts go (falls back to ALERT_EMAIL, then OWNER_EMAIL)
FOUNDER_NAME=                         # signs the personal founder note (renderFounderNote); unset = "the founder"
CHARLIE_TO=you@example.com            # default recipient for local send tests
CHARLIE_USER_EMAIL=you@example.com    # the address local scripts onboard and scan as
PROOF_INBOX=you@example.com           # inbox for scheduler-e2e.mjs and scripts' live proof sends; unset = no live send
PICK_RANK=                            # scripts/send-finding.mjs: 0 = best match, higher = weaker (stress test)
SEED_ONLY=                            # discover-companies.mjs: probe only the non-YC seed list
EMAIL_DRY_RUN=                        # 1 = run the pipeline but skip every real send (role emails and the newsletter)
ONLY_EMAIL=                           # process just this one address (targeted reruns)
ROLE_COHORT=                          # read only by hand-run audit scripts; no send path uses it
ONBOARDING_GRACE_HOURS=               # read only by scripts/suppression-audit.mjs (default 30)
HEALTH_DRY_RUN=                       # health-check.mjs: 1 = do not send the alert
HEALTH_FORCE_FAIL=                    # health-check.mjs: inject a synthetic failure to test the alert path
HEALTH_FORCE_DOSSIER=                 # health-check.mjs: 1 = run the full dossier-build canary now (otherwise weekly; other days a free reachability probe)
HEALTHZ_URL=                          # the /healthz URL watchdog and scripts probe
CHARLIE_HEALTH_URL=                   # the /healthz URL lib/ask-preflight.mjs probes
ANTHROPIC_PROBE_TIMEOUT_MS=           # preflight Anthropic /v1/models probe timeout
GUARD_FIX_SINCE=                      # watchdog.mjs: start of the window in which a repeated or ineligible send counts as a new leak
DEBUG_DOSSIER_RAW=                    # dossier-build.mjs: dump the raw model output
JOBS_FILE=                            # scheduler.mjs: local pool path override (default jobs.json)
SCRATCH=                              # scratch directory for temporary outputs (default /tmp)
PORT=                                 # charlie-remote.ts listen port (default 8787)
RAILWAY_SERVICE_NAME=                 # injected by Railway, never set by hand; recorded in the engine build stamp ("local" when absent)

# ────────────────────────────────────────────────────────────────────────────
# Site (Next.js) — NEXT_PUBLIC_* only
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHARLIE_API_BASE=https://api.<your-domain>   # where the site reads the public /pool-* scan stats
NEXT_PUBLIC_GA_ID=                                       # Google Analytics id; GA is inert when unset

# ────────────────────────────────────────────────────────────────────────────
# Optional integrations (server-side only)
# ────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                         # lifts GitHub API rate limits during URL-ingest grounding (works keyless)
HUNTR_GTM_API_KEY=                    # Huntr GTM warm-intro finder (preferred provider)
HUNTER_API_KEY=                       # Hunter.io warm-intro finder (fallback provider); order: huntr > hunter > none
HUNTER_MONTHLY_CAP=45                 # monthly warm-intro lookup cap shared across users and providers
REFERRAL_REGIONS=us                   # regions where warm-intro referrals may surface (comma list); every other region stays off
REFERRAL_MIN_CONFIDENCE=80            # Hunter confidence bar (0-100); below it no contact is surfaced
REFERRAL_CACHE_DAYS=                  # warm-intro lookup cache TTL in days
BLS_API_KEY=                          # BLS v2 registration key (keyless v1 works without it)
BLS_CACHE_TTL_DAYS=180                # BLS wage cache TTL (wages are annual)
NOTION_TOKEN=                         # Notion integration token for the client-board scripts; each board must be shared with the integration
TALLY_API_KEY=                        # Tally API key; read-only access to applicant submissions (lib/tally.mjs)
SWEEP_WORK_DIR=                       # sweep.mjs working directory (default /tmp/charlie-sweep); holds applicant data, never point it inside the repo
HIRE_YES_LISTS_FILE=                  # path to the operator file holding the human-approved outreach lists (lib/hire-outreach-lifecycle.mjs)

# ────────────────────────────────────────────────────────────────────────────
# Sentry (error reporting) — unset = no-op everywhere; PII is scrubbed in lib/sentry-scrub.mjs
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=               # browser DSN for the site
SENTRY_DSN=                           # server DSN for the Next server, charlie-remote and the engine
SENTRY_ORG=                           # build time: your Sentry org slug for source-map upload; unset (or no SENTRY_PROJECT) = no upload
SENTRY_PROJECT=                       # build time: your Sentry project slug for source-map upload
# SENTRY_AUTH_TOKEN is build-time only (source-map upload); set it in the build environment, not here.

# ────────────────────────────────────────────────────────────────────────────
# Cron heartbeats — pingHeartbeat("<job>") POSTs to HEARTBEAT_URL_<JOB> on a clean finish, where
# <JOB> is the job name uppercased with any character outside [A-Z0-9_] turned into "_".
# Unset = no-op; a failed ping never fails the job.
# ────────────────────────────────────────────────────────────────────────────
HEARTBEAT_URL_ATS_POLL=               # scan-jobs.mjs finished cleanly
HEARTBEAT_URL_MATCH_SEND=             # scheduler.mjs match/gate/compose/send finished cleanly
HEARTBEAT_URL_COVERAGE=               # scheduler.mjs coverage sweep: /fail when an active user got nothing
HEARTBEAT_URL_YC_INGEST=              # yc-ingest.mjs finished cleanly
HEARTBEAT_URL_INDIA_INGEST=           # india-ingest.mjs finished cleanly
HEARTBEAT_URL_SWEEP=                  # sweep.mjs finished with no problems (silent on a run that found problems)
HEARTBEAT_URL_WORKER=                 # worker.mjs pass finished cleanly
HEARTBEAT_URL_PURSUIT_SYNC=           # server/outreach.ts pursuit sync finished cleanly
HEARTBEAT_URL_AGENTS=                 # server/agents.ts 15-minute agents sweep finished cleanly (/fail on any failure)
HEARTBEAT_URL_PIEWORKS=               # charlie-remote 30-minute Pieworks activation pass (/fail when any record failed)
HEARTBEAT_URL_VOICE_PIPELINE=         # voice/pipeline.mjs post-call pipeline sweep (/fail when any session failed)
HEARTBEAT_TIMEOUT_MS=5000             # per-ping timeout in ms

# ────────────────────────────────────────────────────────────────────────────
# Grounding — nothing about a person is sent unless it is grounded in their own material
# ────────────────────────────────────────────────────────────────────────────
VERIFY_MODE=                          # grounding verifier: unset = enforce (hold on a high-severity violation or verifier error); log/off downgrade to logging
VERIFY_CONSTRAINED_DECODE=            # on = schema-constrained verifier output (default off)
GROUNDING_MODE=                       # leave unset (= drop: remove flagged claims, hold on high severity); shadow/hold are debug modes

# ────────────────────────────────────────────────────────────────────────────
# Matching and batch cost guardrails (match-batch.mjs)
# ────────────────────────────────────────────────────────────────────────────
MATCH_BAR=                            # score threshold to pass the bar
MAX_JOBS_PER_USER=                    # pre-filter cap per user. LEAVE BLANK: the default (300) keeps above-bar roles inside the cap; raising it raises per-run spend toward MAX_RUN_COST_USD, which aborts the whole run when crossed
MAX_USERS_PER_RUN=                    # users processed per run
MAX_BATCH_REQUESTS=                   # Anthropic Batch API request cap
MAX_RUN_COST_USD=60                   # hard abort ceiling per run, a runaway backstop rather than a budget; a breach aborts role emails, digest and newsletter together
MATCH_CACHE=                          # on = reuse cached verdicts for unchanged pairs (needs the match_verdicts table)
MATCH_CACHE_TTL_DAYS=                 # re-score a cached verdict after this many days (default 7)
MATCH_CONSTRAINED_DECODE=             # on = schema-constrained scoring output (default off)
MATCH_BATCH_CACHE=                    # prompt caching on the batch prefix (default on); off when logs show cache writes with no reads
MATCH_ONE_TOPN=                       # match-one.mjs: how many roles to score on demand
MATCH_ONE_MODEL=                      # match-one.mjs: model override
BATCH_POLL_MS=                        # batch poll interval (default 5000)
BATCH_TIMEOUT_MS=                     # wait for the Message Batches API before failing the run (default 4h; keep above 1h)
POOL_TABLE=                           # on = read the job pool from job_pool rows instead of the storage blob; falls back to the blob on any error
POOL_JSONL=                           # on = write the job pool one posting per line instead of one JSON array

# Voyage semantic ranking (lib/voyage.mjs, lib/semantic-rank.mjs)
VOYAGE_MODEL=                         # embedding model (default voyage-3.5-lite)
VOYAGE_DIM=                           # output dimension 256|512|1024|2048 (default 512)
VOYAGE_SEMANTIC=                      # on = blend the semantic score into the pre-filter rank
VOYAGE_SEM_WEIGHT=                    # weight of the semantic score in that blend, 0..1 (default 0.5)
VOYAGE_TIMEOUT_MS=                    # per-request timeout
VOYAGE_MAX_RETRIES=                   # retries on a transient failure
VOYAGE_RETRY_BASE_MS=                 # base backoff between retries
VOYAGE_VEC_TTL_MS=                    # in-process vector cache TTL (default 600000)

# ────────────────────────────────────────────────────────────────────────────
# Send gates (quality-gate.mjs, scheduler.mjs) — modes are off | shadow (log only) | enforce
# ────────────────────────────────────────────────────────────────────────────
FIT_FLOOR=                            # minimum fit composite to send rather than digest
FIT_FLOOR_MODE=                       # shadow (default) | v2 | off
UNIFIED_SCORE_MODE=                   # unified composite routing: shadow (default) | enforce | off
UNIFIED_SEND_BAR=                     # unified composite at or above this sends (default 58)
UNIFIED_DIGEST_BAR=45                 # unified composite in [this, send bar) goes to the digest

# Fit Engine v2 send authority (lib/fit-authority.mjs). off = never called; shadow = decision recorded
# only; enforce = may VETO a send the existing gate approved, never create one. Unknown values = off.
FIT_SEND_MODE=off
# Addresses the fit engine has authority over (comma list). EMPTY MEANS NOBODY, never everybody.
FIT_SEND_COHORT=

# The one grounded question in the role email (lib/role-ask-flag.mjs): off | shadow (computed, not rendered) | on.
ROLE_ASK=off
# Addresses that see the question (comma list). EMPTY MEANS NOBODY, never everybody.
ROLE_ASK_COHORT=

GATE_SCAN=6                           # candidates the gate walks per person per run; each survivor costs one coverage call
GATE_FETCH_MS=                        # liveness re-check fetch timeout
GATE_LIVE_RETRIES=                    # liveness re-check retries
GATE_LIVE_BACKOFF_MS=                 # liveness re-check backoff
KNOCKOUT_MODE=shadow                  # eligibility knockout floor (eligibility-gate.mjs)
KNOCKOUT_DEALBREAKER_BODY=off         # also knock out on a dealbreaker found in the JD body (over-blocks on mere mentions)
PREGATE_MODE=                         # eligibility pre-gate: shadow (default) | off
SENIORITY_GATE=shadow                 # hold a role below the lowest level the person asked for; unknown levels pass
SENIORITY_UNDER_FLOOR=                # drop a solo send when the fit pass rates the person "under" and the seniority subscore is at or below this
GHOST_SCORE=shadow                    # hold postings open longer than GHOST_DAYS without closing (evergreen reqs); unknown age passes
GHOST_DAYS=45                         # days continuously open before a posting reads as evergreen
FRESHNESS_MODE=shadow                 # freshness in the send order (freshness.mjs)
FRESHNESS_WEIGHT=0.2                  # blend weight of freshness vs matcher score (0..1)
FRESH_FULL_DAYS=2                     # a role this new counts as fully fresh
FRESH_HORIZON_DAYS=45                 # freshness decays linearly to 0 at this age
FRESH_UNKNOWN=0.2                     # freshness for a role with no parseable posted date
FRESH_PICK_HOURS=12                   # "Fresh pick" badge window
RETRIEVAL_MODE=off                    # role-family regex gate on what a person may be shown
PAY_FLOOR_MODE=                       # drop a solo send whose disclosed pay is below the person's floor (default enforce)
CITY_CORRIDOR=                        # route an onsite/hybrid role outside the person's named cities to the digest (default on)
REMOTE_ACCESS=                        # Tier-1 remote-accessibility gate for non-US candidates (default on)
REMOTE_ACCESS_TIER2=                  # Tier-2 model verifier for ambiguous remote roles (default on)
REMOTE_ACCESS_JD_CAP=                 # max JD characters sent to the Tier-2 verifier (default 6000)
B7_REMOTE_RECOVERY=                   # recover placeless global-remote roles dropped by the company-location heuristic: off (default) | shadow | on
MULTI_REGION=                         # on = treat Canada and Australia as served regions
MARKET_REACH_FILTER=                  # scan-time market reachability filter: off (default) | shadow
CHARLIE_ROLE_FILTER=                  # 1 = re-enable the legacy design/product title pre-filter
DESIRE_COPY=off                       # let the composer lead with the person's stated motivation
PAIRWISE_RANK=                        # order the shortlist by pairwise comparison: off (default) | shadow | on
COMPANY_COOLOFF_DAYS=                 # per-company send cool-off
DIGEST_CAP=5                          # weekly digest role cap

# ────────────────────────────────────────────────────────────────────────────
# Scanner and job pool (scan-jobs.mjs, charlie-store.mjs)
# ────────────────────────────────────────────────────────────────────────────
JOBS_DESC_CAP=2500                    # per-posting description cap in jobs.json. Not cosmetic: the file is one JSON string, V8 caps a string at 536,870,888 chars, and an uncapped pool overflows it and aborts the run
WORKDAY_MAX_PER_BOARD=400             # max postings per Workday board per run; truncation is logged
EIGHTFOLD_MAX_PER_BOARD=300           # max postings per Eightfold board per run (10 per request); truncation is logged
AMAZON_MAX_PER_MARKET=600             # max postings per Amazon market per run; this cap bounds India coverage
POOL_MAX_AGE_HOURS=                   # pool freshness window
COMPANY_CACHE_TTL_DAYS=               # company-insight cache TTL
COMPANY_SEARCH_MAX=                   # max web_search uses per company (composer.mjs)
BORDERLINE_LO=60                      # low end of the borderline score band tracked by stats.mjs
BORDERLINE_HI=80                      # high end of the borderline score band

# YC ingestion (yc-ingest.mjs) and India ingestion (india-ingest.mjs)
YC_INGEST=                            # 0 = disable YC ingestion (default enabled)
YC_RESOLVE_CONCURRENCY=10             # concurrent resolveAts() probes
YC_FEED_TIMEOUT_MS=20000              # feed fetch timeout
INDIA_INGEST=                         # 0 = disable India ingestion (default enabled)
INDIA_RESOLVE_CONCURRENCY=10          # concurrent resolveAts() probes
INDIA_FEED_TIMEOUT_MS=20000           # feed fetch timeout
RESOLVE_ATS_TIMEOUT_MS=8000           # per-ATS-endpoint probe timeout (resolve-ats.mjs)
RESOLVE_ATS_HTML_TIMEOUT_MS=8000      # careers-page fetch timeout
RESOLVE_ATS_MAX_CANDIDATES=4          # candidate slugs tried before mining the careers page

# ────────────────────────────────────────────────────────────────────────────
# Onboarding and inbound
# ────────────────────────────────────────────────────────────────────────────
ONBOARDING_V2=                        # on = new users join the v2 journey (journey.mjs)
ONBOARD_ASK_FIRST=                    # on = ask one question and wait instead of building a profile from too little
ONBOARD_ASK_FIRST_CHARS=              # ask-first threshold in characters (default 400)
ONBOARD_MIN_BIO_CHARS=                # minimum characters of a new person's own words to onboard without a resume
ONBOARD_TRIAGE=                       # cheap triage before the dossier build: shadow (default) | enforce | off
MAX_ATTACHMENT_BYTES=                 # largest attachment the inbound path reads (default 10 MB)
MAX_ATTACHMENTS=                      # attachments read per email (default 5)
INBOUND_MAX_PER_HOUR=                 # inbound emails accepted per address per hour (default 12); excess is dropped silently
REPLY_INTENT=off                      # on = one reply per inbound intent, linted; off = the single acknowledgement template
REPLY_SIGNAL=                         # on = role emails carry a signed chase+ Reply-To so a reply logs intent against that role
EDGE_ENGINE=                          # on = build and store the grounded "edge" (rarest true combination) on the dossier
COMPANY_CONTEXT=                      # on = record each past employer's domain as context on the dossier, never as a skill claim
COMPANY_CONTEXT_MAX=6                 # max distinct past employers researched per dossier

# ────────────────────────────────────────────────────────────────────────────
# Lifecycle emails and drips — all dark until set
# ────────────────────────────────────────────────────────────────────────────
PRO_PITCH=                            # on = show the "what else I could do for you" interest probe in role emails
GIFT_A_ROLE=                          # on = show the "send this role to a friend" block in role emails
POSITION_ASK=                         # on = show the "how to position for this role" link in role emails
COMPLETENESS_NUDGE=off                # completeness nudge sweep: off | dry | on
REPRESENT=                            # "can I represent you?" ask: off | dry | on
DEPTH_SNAPSHOT=                       # depth-per-user time series: off | dry | on
DEPTH_QUESTION=                       # market read plus one question: off | dry | on
GAME_PLAN=                            # on = send the onboarding "game plan" email after the briefing
WEDGE_DRIP=                           # on = send the once-ever "here's your edge" email (needs EDGE_ENGINE)
WEDGE_MIN_AGE_HOURS=24                # a new profile must be this old before its wedge email fires
MARKETGAP_DROP=                       # on = weekly market-gap email for people whose profile keeps just missing
MARKETGAP_STALLED=                    # on = also reach users who had roles and went quiet
MARKETGAP_WEB=                        # on = add attributed web and BLS research to the gap email
MARKETGAP_SCAN=6                      # near-miss roles scored per user to find the recurring gap
MARKETGAP_MIN_COUNT=2                 # a gap must recur across this many near-misses
MARKETGAP_STALLED_MIN_COUNT=3         # recurrence bar for the stalled cohort
MARKETGAP_STALLED_QUIET_DAYS=14       # quiet period before a stalled user is eligible
MARKETGAP_MAX=6                       # lifetime cap of market-gap emails per person
MARKETGAP_SEARCH_MAX=3                # max web_search uses per gap research
MARKETGAP_CACHE_TTL_DAYS=14           # gap research cache TTL, keyed by gap x role x region
MARKETBRIEF_EXCLUDE=                  # comma-separated addresses that never receive the market briefing
MARKETBRIEF_MIN_ADDRESSABLE=8         # minimum reachable roles before a briefing is warranted
STANDOUT_FIT=on                       # briefing spotlight picked by coverage and freshness (about 5 coverage calls once per person); off = relevance only
STANDOUT_SHORTLIST=5                  # top-relevance roles the spotlight ranker chooses between
GAP_CHART=keyword                     # briefing gap chart: keyword | coverage (reuses the STANDOUT_FIT passes; falls back to keyword)
DRIP_GLOBAL_MIN_GAP_DAYS=             # minimum days between any two lifecycle drip emails to one person, of any type (default 2)
# Per-type drip cooldowns in days (drip-guard.mjs); each has an in-code default.
DRIP_COOLDOWN_COMPLETENESS_DAYS=
DRIP_COOLDOWN_DIGEST_DAYS=
DRIP_COOLDOWN_CHECKIN_DAYS=
DRIP_COOLDOWN_PROFILE_DAYS=
DRIP_COOLDOWN_MARKETGAP_DAYS=
DRIP_COOLDOWN_MARKETBRIEF_DAYS=
DRIP_COOLDOWN_PLAN_DAYS=
DRIP_COOLDOWN_INVITE_DAYS=
DRIP_COOLDOWN_REFERRAL_DAYS=
DRIP_COOLDOWN_THESIS_DAYS=
DRIP_COOLDOWN_FOLLOWUP_DAYS=
DRIP_COOLDOWN_WEDGE_DAYS=

# ────────────────────────────────────────────────────────────────────────────
# Hiring campaign (join@ flow) — every verdict is made by a human; Charlie only executes it
# ────────────────────────────────────────────────────────────────────────────
JOIN_CAMPAIGN=                        # on = enable the join@ campaign flow
JOIN_OWNER_EMAIL=                     # the one human who casts verdicts; unset = verdicts are held
JOIN_LOOP_MAX_TURNS=6                 # cap on Charlie messages in the challenge loop
JOIN_STALL_HOURS=                     # silence before the single nudge to a stalled applicant (default 36)
JOIN_CALENDLY=https://calendly.com/<your-link>   # scheduling link sent only after an applicant replies "I'm in"

# ────────────────────────────────────────────────────────────────────────────
# Hiring workspace: Qualify & Submit agent, partner connections, voice verification
# ────────────────────────────────────────────────────────────────────────────
HIRING_WORKSPACE=                     # on = the agents and outreach APIs and their 15-minute schedule run
HIRE_APP_ORIGINS=                     # comma-separated browser origins allowed to call the hiring APIs (CORS), e.g. http://localhost:3001 for the local dashboard; unset = none
CANDIDATE_SCORER=pieworks             # which scorer decides who the agent may contact: pieworks | none (everyone, reviewed by hand)
PIEWORKS_SCORE_THRESHOLD=70           # the pieworks scorer passes a person at or above this score
PIEWORKS_API_BASE=                    # partner API base URL; any unset PIEWORKS_API_* value = the connection refuses to run
PIEWORKS_API_KEY=                     # partner API key
PIEWORKS_REFERRAL_CODE=               # partner referral code sent with submissions
PIEWORKS_WEBHOOK_SECRET=              # HMAC secret verifying partner webhooks; unset = webhooks rejected
PIEWORKS_ACTIVATION=                  # partner shortlist activation emails: off (default) | shadow | live
PIEWORKS_STATS_TO=                    # recipient of the weekly activation stats email
LIFECYCLE_ENGINE=                     # qualify lifecycle engine: shadow (default) | enforce
VOICE_VERIFICATION=                   # on = voice verification routes are served; off = every route 404s
VOICE_DASHBOARD_SECRET=               # bearer secret for the hiring dashboard APIs; unset = refused
VOICE_APP_ORIGIN=                     # origin of the voice call page (defaults to CHARLIE_SITE_URL)
VOICE_LLM_BEARER=                     # bearer the voice provider presents to /voice/llm; unset = refused
VOICE_MAX_PIPELINE_COST_USD=          # model spend cap per post-call pipeline run
ELEVENLABS_API_KEY=                   # ElevenLabs API key for voice sessions
ELEVENLABS_AGENT_ID=                  # ElevenLabs conversational agent id
ELEVENLABS_WEBHOOK_SECRET=            # ElevenLabs post-call webhook HMAC secret; unset = webhooks rejected

# ────────────────────────────────────────────────────────────────────────────
# Model overrides — each has an in-code default
# ────────────────────────────────────────────────────────────────────────────
COMPOSE_MODEL=                        # role-email composer
DOSSIER_THINKING=                     # off = disable adaptive thinking on the dossier build (default on)
DOSSIER_EFFORT=                       # dossier reasoning effort: low|medium|high|xhigh|max (default high)
RESUME_MODEL=                         # tailored resume
CHECK_MODEL=                          # check@ fit scorecard
VERIFY_MODEL=                         # grounding verifier
PREF_MODEL=                           # preference write-back
TRACK_MODEL=                          # application-tracking classifier
REFERRAL_MODEL=                       # warm-intro draft
FIT_MODEL=                            # fit coverage
YEARS_MODEL=                          # professional-years reader
TRIAGE_MODEL=                         # onboarding triage
ENRICH_MODEL=                         # applicant enrichment
EDGE_MATCH_MODEL=                     # edge-to-role matcher
PAIRWISE_MODEL=                       # pairwise shortlist ranker
POSITION_MODEL=                       # positioning build
STORY_BUILD_MODEL=                    # represent story writer
STORY_VERIFY_MODEL=                   # represent story verifier
INBOUND_INTENT_MODEL=claude-haiku-4-5-20251001   # inbound intent classifier
INBOUND_REPLY_MODEL=                  # conversational reply composer
MARKETGAP_MODEL=                      # market-gap email composer
MARKETGAP_RESEARCH_MODEL=             # market-gap web research
WEDGE_MODEL=                          # wedge email composer
JOIN_MODEL=                           # hiring-campaign challenge composer
MANDATE_PARSE_MODEL=                  # mandate parser
XYZ_SCREEN_MODEL=                     # applicant X-Y-Z screen
HIRE_WHY_MODEL=                       # candidate justification note
HIRE_MANDATE_ANSWERS_MODEL=           # files replies against mandate questions
VOICE_PLANNER_MODEL=                  # voice: question planner
VOICE_ASK_MODEL=                      # voice: live question wording
VOICE_EXTRACTOR_MODEL=                # voice: evidence extractor
VOICE_JUDGE_MODEL=                    # voice: judge
VOICE_WRITER_MODEL=                   # voice: report writer

# ────────────────────────────────────────────────────────────────────────────
# Marketing site (app/) — public values only
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://<your-domain>              # canonical site URL for metadata (default https://example.com)
NEXT_PUBLIC_START_ADDR=start@mail.<your-domain>          # the address the landing page's "Reply" button writes to
