#!/usr/bin/env bash
# .githooks/pre-push — local pre-push gate. Runs the same checks as .github/workflows/ci.yml; a red
# check stops the push. Enable it once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

step() { echo; echo "pre-push: $1"; }

step "typecheck"; npm run typecheck
step "lint"; npm run lint
step "test"; npm test
step "build"; npm run build
step "migration guard"; bash scripts/check-migrations.sh origin/main

echo; echo "pre-push: all checks green"
