{
  "name": "charlie",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:remote": "tsx server/charlie-remote.ts",
    "engine:run": "node preflight.mjs --phase=pre-scan && node presend-guard.test.mjs && ( node yc-ingest.mjs ; node india-ingest.mjs ; node --max-old-space-size=4096 scan-jobs.mjs ; true ) && node preflight.mjs --phase=pre-send && ( node --max-old-space-size=4096 scheduler.mjs ; node --max-old-space-size=4096 newsletter.mjs --cron ; true ) ; rc=$? ; node health-check.mjs ; node watchdog.mjs --cron ; node --max-old-space-size=4096 run-eval.mjs ; exit $rc",
    "engine:scan": "node preflight.mjs --phase=pre-scan && ( node yc-ingest.mjs ; node india-ingest.mjs ; node --max-old-space-size=4096 scan-jobs.mjs ; true ) ; node health-check.mjs",
    "preflight": "node preflight.mjs",
    "test:guard": "node presend-guard.test.mjs",
    "test:drip": "node drip-guard.test.mjs",
    "test:preflight-logic": "node preflight.test.mjs",
    "test:knockout": "node eligibility-gate.test.mjs",
    "test:freshness": "node freshness.test.mjs",
    "test:font": "node app/font-guard.test.mjs",
    "scheduler": "node scheduler.mjs",
    "scheduler:test": "node scheduler-e2e.mjs",
    "health": "node health-check.mjs",
    "db:types": "supabase gen types typescript --linked > lib/database.types.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:emails": "vitest run emails",
    "test:prompts": "vitest run prompts",
    "test:schemas": "vitest run lib/schemas",
    "test:evals": "vitest run evals",
    "test:voice": "vitest run voice",
    "voice:plan": "node --env-file=.env.local scripts/vv-plan.mjs",
    "voice:text": "node --env-file=.env.local voice/text-mode.mjs",
    "voice:agent": "node --env-file=.env.local scripts/vv-agent.mjs",
    "voice:pipeline": "node --env-file=.env.local scripts/vv-pipeline.mjs",
    "test": "vitest run && npm run test:guard && npm run test:drip && npm run test:preflight-logic && npm run test:knockout && npm run test:freshness && npm run test:font",
    "sweep:run": "node sweep.mjs",
    "worker:run": "node worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "@supabase/supabase-js": "^2.45.4",
    "cobe": "^2.0.1",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.14.0",
    "tsx": "^4.22.4",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}
